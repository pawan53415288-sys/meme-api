# Copy to .env and fill in. Never commit the real .env.

# Required — OpenRouter API key (https://openrouter.ai/keys)
OPEN_ROUTER_API_KEY=

# Optional — pin one model and try it first. Free ids look like "vendor/model:free".
# Browse: https://openrouter.ai/models?max_price=0
# OPENROUTER_MODEL=

# Optional — port to listen on (defaults to 8787)
# PORT=8787

# Optional — comma-separated origins allowed to call this API from a browser.
# Leave unset in development; set it in production to your deployed frontend URL.
# Multiple: https://my-web.vercel.app,https://my-web.pages.dev
# ALLOWED_ORIGINS=